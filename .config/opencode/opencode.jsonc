{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "model": "opencode-go/glm-5.2"
    },
    "build": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "lsp": true,
  "plugin": [
    "opencode-wakatime"
  ],
  "mcp": {
    "MCP_DOCKER": {
      "type": "local",
      "command": ["docker.exe", "mcp", "gateway", "run", "--profile", "default"],
      "enabled": true
    }
  }
}
